{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rabellion/Rencord/docs/themes/theme.schema.json",
  "title": "Rencord theme",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "id"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "mode": { "enum": ["light", "dark", ""] },
    "chrome": { "enum": ["ink", "classic", ""] },
    "derive": { "type": "boolean" },
    "base": { "type": ["string", "null"] },
    "accent": { "type": ["string", "null"] },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bg.base": { "$ref": "#/$defs/hex" },
        "bg.elevated": { "$ref": "#/$defs/hex" },
        "bg.sunken": { "$ref": "#/$defs/hex" },
        "bg.rail": { "$ref": "#/$defs/hex" },
        "bg.sidebar": { "$ref": "#/$defs/hex" },
        "bg.chat": { "$ref": "#/$defs/hex" },
        "bg.members": { "$ref": "#/$defs/hex" },
        "bg.input": { "$ref": "#/$defs/hex" },
        "bg.hover": { "$ref": "#/$defs/hex" },
        "bg.selected": { "$ref": "#/$defs/hex" },
        "bg.mention": { "$ref": "#/$defs/hex" },
        "bg.overlay": { "$ref": "#/$defs/hex" },
        "bg.add": { "$ref": "#/$defs/hex" },
        "bg.voice": { "$ref": "#/$defs/hex" },
        "bg.home": { "$ref": "#/$defs/hex" },
        "bg.home.active": { "$ref": "#/$defs/hex" },
        "bg.badge": { "$ref": "#/$defs/hex" },
        "bg.reaction": { "$ref": "#/$defs/hex" },
        "bg.reaction.mine": { "$ref": "#/$defs/hex" },
        "bg.hangup": { "$ref": "#/$defs/hex" },
        "bg.stage": { "$ref": "#/$defs/hex" },
        "bg.qr": { "$ref": "#/$defs/hex" },
        "text.primary": { "$ref": "#/$defs/hex" },
        "text.muted": { "$ref": "#/$defs/hex" },
        "text.faint": { "$ref": "#/$defs/hex" },
        "text.link": { "$ref": "#/$defs/hex" },
        "text.secondary": { "$ref": "#/$defs/hex" },
        "text.mention": { "$ref": "#/$defs/hex" },
        "text.danger": { "$ref": "#/$defs/hex" },
        "text.positive": { "$ref": "#/$defs/hex" },
        "text.home": { "$ref": "#/$defs/hex" },
        "text.home.active": { "$ref": "#/$defs/hex" },
        "text.add": { "$ref": "#/$defs/hex" },
        "text.badge": { "$ref": "#/$defs/hex" },
        "text.voice": { "$ref": "#/$defs/hex" },
        "text.hangup": { "$ref": "#/$defs/hex" },
        "border.hairline": { "$ref": "#/$defs/hex" },
        "border.strong": { "$ref": "#/$defs/hex" },
        "border.accent": { "$ref": "#/$defs/hex" },
        "border.home": { "$ref": "#/$defs/hex" },
        "border.home.active": { "$ref": "#/$defs/hex" },
        "border.add": { "$ref": "#/$defs/hex" },
        "border.voice": { "$ref": "#/$defs/hex" },
        "border.hover": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" },
        "accent.fg": { "$ref": "#/$defs/hex" },
        "danger": { "$ref": "#/$defs/hex" },
        "positive": { "$ref": "#/$defs/hex" },
        "status.online": { "$ref": "#/$defs/hex" },
        "status.idle": { "$ref": "#/$defs/hex" },
        "status.dnd": { "$ref": "#/$defs/hex" },
        "status.offline": { "$ref": "#/$defs/hex" },
        "syntax.keyword": { "$ref": "#/$defs/hex" },
        "syntax.number": { "$ref": "#/$defs/hex" },
        "pill": { "$ref": "#/$defs/hex" },
        "shadow": { "$ref": "#/$defs/hex" }
      }
    },
    "metrics": { "$ref": "#/$defs/metrics" },
    "background": { "$ref": "#/$defs/background" }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#?[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font_ui": { "type": "string" },
        "font_mono": { "type": "string" },
        "font_meta": { "type": "string" },
        "font_scale": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "radius_scale": { "type": "number", "minimum": 0, "maximum": 2 },
        "message_spacing": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "saturation": { "type": "number", "minimum": 0, "maximum": 1 },
        "gap": { "type": "number", "minimum": 0, "maximum": 32 },
        "rail_width": { "type": "number" },
        "tile_size": { "type": "number" },
        "radius_tile": { "type": "number" },
        "radius_panel": { "type": "number" },
        "radius_control": { "type": "number" },
        "message_py": { "type": "number" },
        "message_gap": { "type": "number" },
        "shadow_blur": { "type": "number" },
        "shadow_y": { "type": "number" }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["solid", "gradient"] },
        "angle": { "type": "number" },
        "stops": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/hex" } },
        "grain": { "type": "number", "minimum": 0, "maximum": 0.03 },
        "image": { "type": "string" },
        "blur": { "type": "number", "minimum": 0, "maximum": 40 },
        "dim": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
